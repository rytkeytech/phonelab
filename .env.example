# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real keys.

# Supabase → Project Settings → API Keys (or Data API)
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The *publishable* key (starts with sb_publishable_), or the legacy "anon" key.
# Safe in the browser because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the app runs; used for sign-in email links.
# Local: http://localhost:3000   Production: your Vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only, for "npm run db:apply" (never NEXT_PUBLIC_, never commit).
# The database password you set when creating the project
# (Project Settings → Database → Reset database password if lost).
SUPABASE_DB_PASSWORD=
# Your project's region code, e.g. eu-west-2 or us-east-1
# (Project Settings → General, or the region shown under the project name).
SUPABASE_DB_REGION=
# Alternative to the two lines above: the full "Session pooler" URI from
# Supabase → Connect. Leave empty to use password + region.
SUPABASE_DB_URL=

# Never add the Supabase *secret* / service_role key with a NEXT_PUBLIC_ prefix.
